#!/bin/sh

if ! command -v php >/dev/null 2>&1; then
  echo "pre-push: php is not installed; skipping PHP syntax checks" >&2
  exit 0
fi

status=0

files=$(git ls-files -- '*.php')

while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$file" in
    vendor/* | .tmp/*) continue ;;
  esac
  if [ -f "$file" ] && ! php -l "$file"; then
    status=1
  fi
done <<ENDOFFILES
$files
ENDOFFILES

if [ -f config.inc.php.dist ] && ! php -l config.inc.php.dist; then
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "pre-push: php -l failed, fix syntax errors before pushing" >&2
fi

exit "$status"
