#!/bin/sh
# Enforce: <type>: <text> (maximum 60 characters total).
# Merge commits and titles starting with ! are exempt.

msg_file=${1:-.git/COMMIT_EDITMSG}

if [ ! -r "$msg_file" ]; then
    printf 'commit-msg: cannot read message file: %s\n' "$msg_file" >&2
    exit 1
fi

line=$(head -n 1 "$msg_file" | sed 's/\r$//')

case "$line" in
    "Merge "* | "Revert "* | fixup!* | squash!* | \!*)
        exit 0
        ;;
esac

types='feat|fix|docs|refactor|style|test|perf|build|ci|chore'

# TODO: a missing or unknown prefix only warns for now; flip this back to an
# exit 1 once every contributor habitually uses the format.
if ! printf '%s\n' "$line" | grep -Eq "^(${types}): .+"; then
    printf '%s\n' \
        "commit-msg: warning: expected '<type>: <text>' (not blocking yet)." \
        "Allowed types: feat, fix, docs, refactor, style, test, perf, build, ci, chore." >&2
fi

length=${#line}
if [ "$length" -gt 60 ]; then
    printf 'commit-msg: title is %s characters; maximum is 60, including the prefix.\n' "$length" >&2
    exit 1
fi

exit 0
