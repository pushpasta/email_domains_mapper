# Keep in sync with .distignore.
# Shell hooks must keep LF endings (core.autocrlf would break sh).
/.githooks/* text eol=lf
# These export-ignore lines trim the source archive generated by
# git archive (GitHub release zipball / Packagist Composer dist).
/.distignore export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.githooks export-ignore
/.github export-ignore
/.gitignore export-ignore
/.tmp export-ignore
/AGENTS.md export-ignore
/phpunit.xml.dist export-ignore
/tests export-ignore
