{
  "name": "pushpasta/email_domains_mapper",
  "type": "roundcube-plugin",
  "description": "Roundcube plugin that selects IMAP, SMTP and optional ManageSieve hosts from defined mappings based on the domain of the user's full email login address. Rejects unknown domains before connecting and enables ManageSieve only for domains with a configured Sieve server.",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "CodeAlDente",
      "email": "mail@codealdente.ovh",
      "role": "Developer"
    }
  ],
  "keywords": [
    "domain-mapping",
    "domain-routing",
    "email",
    "imap",
    "mail-server",
    "managesieve",
    "multi-domain",
    "plugin",
    "roundcube",
    "roundcube-plugin",
    "server-selection",
    "sieve",
    "smtp",
    "webmail"
  ],
  "support": {
    "issues": "https://github.com/pushpasta/email_domains_mapper/issues",
    "source": "https://github.com/pushpasta/email_domains_mapper"
  },
  "homepage": "https://github.com/pushpasta/email_domains_mapper",
  "require": {
    "php": ">=8.1.0",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "roundcube/plugin-installer": "~0.3.5"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.13",
    "friendsofphp/php-cs-fixer": "^3.8",
    "phpstan/extension-installer": "^1.1",
    "phpstan/phpstan": "~2.2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
    "roundcube/roundcubemail": "^1.7",
    "symfony/yaml": "^6.4 || ^7.0"
  },
  "autoload": {
    "classmap": [
      "email_domains_mapper.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "cs": "php-cs-fixer fix --dry-run --diff --using-cache=no",
    "cs:fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse --no-progress",
    "check": [
      "@cs",
      "@phpstan",
      "@test"
    ],
    "lint:composer": "@composer validate --strict --no-check-lock",
    "hooks:install": "git config core.hooksPath .githooks",
    "post-install-cmd": [
      "@hooks:install"
    ],
    "post-update-cmd": [
      "@hooks:install"
    ]
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "roundcube/plugin-installer": true
    }
  },
  "extra": {
    "roundcube": {
      "min-version": "1.7"
    }
  }
}
